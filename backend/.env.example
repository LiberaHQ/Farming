# Copy to backend/.env to override defaults. Everything here is optional.

# By default the backend runs an embedded PostgreSQL (PGlite) and stores data in backend/.data/.
# To use a PostgreSQL server instead (Homebrew, Postgres.app, hosted), set:
# DATABASE_URL=postgres://user:password@localhost:5432/farming

# Where the embedded database keeps its files:
# PGLITE_DATA_DIR=./.data/pglite

PORT=4000
# NODE_ENV=production   # marks the session cookie Secure (HTTPS only)

# Co-op (Socket.IO) accepts connections from pages served by this same machine
# (any port). To allow other origins (e.g. a separately hosted frontend), list them:
# CORS_ORIGINS=https://farm.example.com
